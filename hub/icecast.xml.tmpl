<!-- Rendered by turntail-hub mounts. Edit the template, not icecast.xml. -->
<icecast>
    <location>the tailnet</location>
    <admin>admin@turntail</admin>
    <hostname>__HUB_FQDN__</hostname>

    <limits>
        <clients>200</clients>
        <sources>16</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <source-password>__ICECAST_SOURCE_PW__</source-password>
        <relay-password>__ICECAST_RELAY_PW__</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>__ICECAST_ADMIN_PW__</admin-password>
    </authentication>

    <listen-socket>
        <port>8000</port>
        <bind-address>127.0.0.1</bind-address>
    </listen-socket>

    <!-- MOUNTS -->

    <fileserve>0</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/var/lib/turntail/icecast-web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
    </paths>

    <logging>
        <accesslog>-</accesslog>
        <errorlog>-</errorlog>
        <loglevel>2</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
        <changeowner>
            <user>icecast2</user>
            <group>icecast</group>
        </changeowner>
    </security>
</icecast>
